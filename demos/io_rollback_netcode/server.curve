# The relay: one process, every room. PORT picks the port
# (default 7777). See the Server section of netcode.curve.
#
#   curve demos/io_rollback_netcode/server.curve -o relay && ./relay
import Base
import ./netcode.curve as Net

def main() -> IO(Unit):
  do IO<Unit>:
    port : String <- Net.Env.get("PORT", "7777")
    Net.Server.run(Net.Env.u32(port, 7777))
