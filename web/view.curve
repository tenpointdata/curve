import Base

type Prop is Data:
  ViewTextProp{name: String, value: String}
  ViewBoolProp{name: String, value: Bool}
  ViewNumberProp{name: String, value: U32}

type Node is Data:
  ViewText{value: String}
  ViewElement{tag: String, props: List<&2, Prop>, children: List<&2, Node>}
  ViewFragment{children: List<&2, Node>}
  ViewList{children: List<&2, Node>}
  ViewKeyed{key: String, child: Node}

def choose(condition: Bool, yes: Unit -> Node, no: Unit -> Node) -> Node:
  match condition:
    case True{}:
      yes(Unit{})
    case False{}:
      no(Unit{})

def map.loop(~A: Data, ~f: A -> Node, xs: List<&2, A>, acc: List<&2, Node>) -> List<&2, Node>:
  match xs:
    case Nil{}:
      List.reverse(&2, Node, acc)
    case head <> tail:
      +item = head
      map.loop(~A, ~f, tail, f(item) <> acc)

def map(~A: Data, ~f: A -> Node, xs: List<&2, A>) -> List<&2, Node>:
  map.loop(~A, ~f, xs, Nil{})
